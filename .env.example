# ==============================================================================
# VEE POWER ELECTRICALS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Populate environment-specific secrets before starting services.
# 3. Never commit .env or production credentials into git repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
# Options: development | test | staging | production
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8)
# ------------------------------------------------------------------------------
DATABASE_ENGINE=django.db.backends.mysql
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=veepower_db
DATABASE_USER=veepower
DATABASE_PASSWORD=replace_with_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
USE_SQLITE=False

# ------------------------------------------------------------------------------
# 3. DJANGO BACKEND SECURITY & CORE
# ------------------------------------------------------------------------------
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace_with_secure_random_django_secret_key_minimum_50_chars
JWT_SECRET_KEY=replace_with_secure_random_jwt_signing_key_minimum_50_chars
STRICT_PROD_SECRET=True

# Hostnames & Routing
ALLOWED_HOSTS=veepower.in,api.veepower.in,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=https://veepower.in,http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=https://veepower.in,https://api.veepower.in,http://localhost

# HTTPS & Security Headers (Enable when behind SSL-terminating reverse proxy/CDN)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ------------------------------------------------------------------------------
# 4. STATIC & MEDIA STORAGE
# ------------------------------------------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/

# ------------------------------------------------------------------------------
# 5. DEMO DATA SEEDING (DEVELOPMENT / STAGING ONLY)
# ------------------------------------------------------------------------------
# Must be False in production to prevent loading demo catalog and prices
SEED_DEMO_DATA=False

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATION GATEWAY
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@veepower.in
EMAIL_HOST_PASSWORD=replace_with_smtp_credentials
DEFAULT_FROM_EMAIL=Vee Power Electricals <noreply@veepower.in>

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (VITE PUBLIC ASSETS)
# ------------------------------------------------------------------------------
# Note: VITE_* variables are publicly embedded into client JavaScript bundles
VITE_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
